# Copy to .env (or export these in your shell) and fill in your own values.
# Never commit the real values.
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=mysql://root:@localhost/covid
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Set to 1 only for local development (enables the Werkzeug debugger)
FLASK_DEBUG=0
# Only needed if you enable flask_mail in main.py
MAIL_USERNAME=
MAIL_PASSWORD=
